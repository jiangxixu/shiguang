{
  "manifest_version": 3,
  "name": "拾光 · 一键收藏",
  "description": "点击扩展即收藏当前网页，稍后打开拾光自动查看，无需手动导入。",
  "version": "1.2.1",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://jiangxixu.github.io/*",
    "https://pkgsgkrjhcckmcjqdzws.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "点击即收藏当前网页 · 拾光"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jiangxixu.github.io/shiguang/*"
      ],
      "js": [
        "core.js",
        "capture-store.js",
        "library-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "popup.html"
}
