{
  "manifest_version": 3,
  "name": "拾光 · 一键收藏",
  "description": "快捷键或网页右键收藏，可填写分类和收藏原因，自动归入拾光知识库。",
  "version": "1.4.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://jiangxixu.github.io/*",
    "https://pkgsgkrjhcckmcjqdzws.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "点击即收藏当前网页 · 拾光"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shortcut.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jiangxixu.github.io/shiguang/*"
      ],
      "js": [
        "core.js",
        "capture-store.js",
        "library-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "popup.html",
  "commands": {
    "save-current-page": {
      "suggested_key": {"default": "Alt+Shift+S"},
      "description": "收藏当前网页到拾光"
    }
  }
}
